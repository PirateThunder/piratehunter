# PirateHunter — корневой .env (скопируй в .env и заполни). Единый
# источник секретов для docker compose (паттерн piratepitch).

# Пароли Postgres (backend и core-api — свои базы: ph_back / ph_core)
BACK_DB_PASSWORD=change-me-back
CORE_DB_PASSWORD=change-me-core

# backend: сессии (JWT HS256). Для прода — длинная случайная строка
BACK_JWT_SECRET=change-me-dev-jwt-secret-0123456789abcdef

# local|staging|prod — /docs виден в local/staging; в проде публичный
# OpenAPI открывается флагом BACK_DOCS_PUBLIC=1 → https://api.piratehunter.fun/docs
BACK_ENV=local

# Локальный вход без почты (POST /auth/dev + кнопка на /login); в проде 0
BACK_AUTH_DEV_LOGIN=1
NEXT_PUBLIC_DEV_LOGIN=1

# CORS: Origin фронта (через запятую, если несколько)
BACK_CORS_ORIGINS=http://localhost:56151

# Межсервисные адреса (значения по умолчанию — локальный запуск без compose)
BACK_CORE_API_URL=http://localhost:51457
BACK_FSP_REGISTRY_URL=http://localhost:52457
# Browser-facing адрес мок-OIDC «FSP ID» (authorize-страница). В проде —
# поддомен fsp-id.* (блок в Caddyfile), у реестра тот же адрес = issuer
BACK_FSP_PUBLIC_URL=http://localhost:52457
# GET-callback backend'а на origin фронта (Next проксирует /api/* → backend)
BACK_FSP_REDIRECT_URI=http://localhost:56151/api/v1/auth/fsp/callback
BACK_FRONT_URL=http://localhost:56151

# core-api: внутренний токен (X-Internal-Token; пусто = без проверки, dev),
# LLM для перефразировки/парсинга. Провайдер: cloudru (ДЦ РФ, 152-ФЗ-контур)
# или openrouter; без ключей — детерминированный fallback
CORE_ENV=local
CORE_INTERNAL_TOKEN=
HUNTER_LLM_PROVIDER=cloudru
CLOUDRU_API_KEY=
OPENROUTER_API_KEY=
HUNTER_LLM_MODEL=

# fsp_registry: секрет подписи мок-JWT (пусто = дев-дефолт в образе)
FSPREG_JWT_SECRET=

# frontend: 0 — живые вызовы /api/v1 (боевой режим), 1 — кабинеты на моках
NEXT_PUBLIC_API_MOCK=0

# SMTP для отправки кода входа. Пустой BACK_SMTP_HOST — код пишется
# в лог backend (локальная разработка проходит без почты)
BACK_SMTP_HOST=
BACK_SMTP_PORT=465
BACK_SMTP_USER=
BACK_SMTP_PASSWORD=
BACK_SMTP_FROM=
