# --- Public (inlined into the browser bundle at build time) ---
# Dev-only demo-account login (POST /api/v1/auth/dev). Set 1 on stands/local,
# leave empty in production to hide the dev login form.
NEXT_PUBLIC_DEV_LOGIN=

# '1' — typed mock fixtures for cabinet reads (offline dev).
# Default (empty) — live backend.
NEXT_PUBLIC_API_MOCK=

# --- Server-only (never exposed to the browser) ---
# Where /api/* rewrites proxy to. Baked at build time (see next.config.ts).
BACKEND_URL=http://localhost:64844
