# PirateHunter — прод. Caddy сам выпускает и продлевает сертификаты
# Let's Encrypt (HTTP-01), редиректит HTTP→HTTPS. Требуются A-записи
# piratehunter.fun и fsp-id.piratehunter.fun на IP сервера и открытые
# порты 80/443 (deploy-vps.sh открывает через ufw).
#
# ВАЖНО: Caddyfile примонтирован в контейнер файлом. git pull заменяет
# файл новым инодом, и контейнер продолжает видеть СТАРЫЙ конфиг.
# После правок этого файла:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     up -d --force-recreate caddy

# Основной сайт: лендинг + оба ЛК (Next.js)
piratehunter.fun {
	encode zstd gzip
	reverse_proxy frontend:56151
}

# www → apex
www.piratehunter.fun {
	redir https://piratehunter.fun{uri} permanent
}

# Мок-OIDC «FSP ID» (fsp_registry): браузер должен достучаться до
# authorize-страницы — в бою это внешний провайдер, на стенде мок
# выставлен отдельным поддоменом (BACK_FSP_PUBLIC_URL = этот адрес).
fsp-id.piratehunter.fun {
	encode zstd gzip
	reverse_proxy fsp-registry:52457
}

# Публичный API: OpenAPI-документация для интеграторов (ATS/партнёры).
# Требуется A-запись api → IP; docs открывается флагом BACK_DOCS_PUBLIC=1.
api.piratehunter.fun {
	encode zstd gzip
	reverse_proxy backend:64844
}

# --- internal-сервисы: НАРУЖУ НЕ ВЫСТАВЛЕНЫ намеренно (PRD §4.2) ------
# core-api (:51457) — внутренний API, с ним общается только backend
# внутри docker-сети. Backend наружу не проксируется: браузер ходит
# same-origin через /api/* (Next-rewrites фронта).
